#
# https://help.github.com/articles/dealing-with-line-endings/
#
# Sources are written with LF. Keep LF in the repository and in every working copy,
# whatever core.autocrlf says (Git for Windows defaults it to true).
* text=auto eol=lf

# Linux start scripts (at any depth, e.g. test-addon/gradlew) must use lf
gradlew         text eol=lf

# These are Windows script files and should use crlf
*.bat           text eol=crlf

# Binary files
*.jar           binary
*.png           binary
